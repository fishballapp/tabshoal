{
  "name": "@tabshoal/extension",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "exports": {
    "./polar-config": "./src/licence/polar-config.ts",
    "./price": "./src/licence/price.ts"
  },
  "description": "TabShoal: a Chrome (MV3) extension that groups tabs by site, automatically.",
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "build:local": "vite build && mkdir -p ~/.chrome-extensions-dev/tabshoal && rsync -a --delete dist/ ~/.chrome-extensions-dev/tabshoal/",
    "build:release": "vite build --mode release",
    "zip": "pnpm build:release && node scripts/zip.ts",
    "icons": "node scripts/build-icons.ts",
    "test": "vitest run",
    "check:effect": "effect-tsgo diagnostics --project tsconfig.json --format text"
  },
  "dependencies": {
    "@base-ui/react": "catalog:",
    "@fishballapps/cn": "workspace:*",
    "@fishballapps/utils": "workspace:*",
    "class-variance-authority": "catalog:",
    "effect": "catalog:",
    "react": "catalog:web",
    "react-dom": "catalog:web",
    "tldts": "catalog:"
  },
  "devDependencies": {
    "@fishballapps/vite-plugins": "workspace:*",
    "@tailwindcss/vite": "catalog:",
    "@types/chrome": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:web",
    "@types/react-dom": "catalog:web",
    "@vitejs/plugin-react": "catalog:",
    "sharp": "catalog:",
    "tailwindcss": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
